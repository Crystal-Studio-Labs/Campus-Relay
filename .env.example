# [TEMPLATE]
# ---- Copy to .env and adjust. Never commit .env ----
#
# This one file serves BOTH deployment shapes described in docs/DEPLOYMENT.md:
#   * Split cloud: frontend on Vercel, backend on Render, database on Supabase.
#   * Single machine: docker compose -f docker-compose.selfhost.yml (uses only
#     the POSTGRES_* block below; DATABASE_URL stays empty).

# =====================================================================
# Database
# =====================================================================
# --- Local / single-machine install ---
POSTGRES_USER=campus
POSTGRES_PASSWORD=campus
POSTGRES_DB=campus_relay
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Hosted (Supabase / Neon / Render) ---
# Leave EMPTY for local or single-machine. When set, it wins over the block
# above and the backend rewrites the scheme to postgresql+psycopg:// for you.
# Supabase pooled connection string example (note ?sslmode=require):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Supabase caps connections on its free tier; keep the pool modest on a host.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# =====================================================================
# Backend
# =====================================================================
APP_ENV=development
APP_SECRET_KEY=dev-only-change-me-in-any-real-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated allowed browser origins. For split hosting this MUST include
# your deployed frontend origin, e.g. https://campus-relay.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: path to a different institution template. Empty = config/institution.json
INSTITUTION_CONFIG_PATH=

# Optional intelligence layer. AGENT_PROVIDER=rules (default) uses deterministic
# local engines only - no network calls, no API key.
AGENT_PROVIDER=rules
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=

# =====================================================================
# Notification channels
# =====================================================================
# In-app is always on. Everything below is optional and reports honestly:
# an unconfigured channel is never queued and never reported as delivered.

# --- Telegram (works with a bot token; no business approval needed) ---
# Create a bot with @BotFather, paste the token here, then each user links a
# chat id from Profile -> Notification channels.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org

# --- WhatsApp (Meta Cloud API) ---
# Needs a Meta business account, a phone-number id, a permanent token, and an
# approved template for institution-initiated messages.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_BASE=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0

# --- Web push (optional provider + VAPID pair) ---
PUSH_PROVIDER_URL=
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_SUBJECT=

# --- Outbound delivery worker (drains the notification outbox) ---
# Automatically disabled when APP_ENV=test. Drain manually with:
#   python -m app.services.delivery --once
DELIVERY_WORKER_ENABLED=true
DELIVERY_POLL_SECONDS=10
DELIVERY_BATCH_SIZE=25
DELIVERY_TIMEOUT_SECONDS=8

# =====================================================================
# Frontend (Vite build-time; NOT read by the backend)
# =====================================================================
# Leave EMPTY for local dev (Vite proxy) and for the single-machine install
# (nginx proxies /api). For split hosting set the deployed backend origin:
#   VITE_API_BASE_URL=https://campus-relay-api.onrender.com
VITE_API_BASE_URL=

# Single-machine install: the port the web container is published on.
WEB_PORT=8080
